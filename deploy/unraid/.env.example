# Public settings; these values are visible to users' browsers.
APP_HTTP_PORT=8088
API_GW_HTTP_PORT=8000
SUPABASE_PUBLIC_URL=http://UNRAID-LAN-IP:8000
ALLOWED_ORIGIN=http://UNRAID-LAN-IP:8088
FUNCTIONS_VERIFY_JWT=false
# Server-only secret for managing the shared challenge catalog and random team-name pool.
# Use at least 32 random characters. The preparation script generates a secure value.

# The prepare script generates non-default values for POSTGRES_PASSWORD,
# JWT_SECRET, ANON_KEY, and SERVICE_ROLE_KEY in the ignored .env file.
# Do not copy upstream example secret values into this file.

# Persistent paths must be dedicated to this Supabase installation.
APPDATA_ROOT=/mnt/user/appdata/game-night-supabase
